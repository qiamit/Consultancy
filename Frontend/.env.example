# Copy to .env.local (local) or set in Railway → Variables.

# ── Postgres (Railway Postgres plugin → DATABASE_URL) ─────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Session cookie signing (iron-session). Must be ≥ 32 characters.
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Super admin email — this account always gets full admin access in the dashboard
SUPER_ADMIN_EMAIL=info@qengineering.in

# ── S3-compatible object storage (Railway Bucket / MinIO / AWS) ───────────────
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto

# Documents bucket
S3_DOCUMENTS_BUCKET=documents
S3_DOCUMENTS_ACCESS_KEY_ID=
S3_DOCUMENTS_SECRET_ACCESS_KEY=

# IS Code documents bucket
S3_IS_CODE_BUCKET=is-code-documents
S3_IS_CODE_ACCESS_KEY_ID=
S3_IS_CODE_SECRET_ACCESS_KEY=

# ── QE Assistant AI (public website chat — /api/qe-chat) ─────────────────────
# Pick provider: anthropic | google
QE_AI_PROVIDER=anthropic

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here
# Model ID examples: claude-haiku-4-5-20251001, claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Model ID examples: gemini-2.5-flash, gemini-2.5-pro, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Maps Embed API for in-app route maps (Location Map in Application Checklist)
# https://console.cloud.google.com/google/maps-apis — enable Maps Embed API
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ── Resend (outbound email for @qengineering.in) ──────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=info@qengineering.in
RESEND_FROM_NAME=Q Engineering
RESEND_FROM_DOMAIN=qengineering.in
