# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
#
# Vercel production: Project → Settings → Environment Variables — set the same keys for
# Production (and Preview if needed), then redeploy. Wrong NEXT_PUBLIC_SUPABASE_URL causes
# login failures (ERR_NAME_NOT_RESOLVED / Failed to fetch).

NEXT_PUBLIC_SUPABASE_URL=https://zpsflksszoktlzgrytpb.supabase.co

# Use the "anon" / "public" key (safe for the browser). Never put the service_role key in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inpwc2Zsa3Nzem9rdGx6Z3J5dHBiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0MjA5MTIsImV4cCI6MjA5Njk5NjkxMn0.OXCLOrFCBCipaD3odOxukYpL-x6h57cInSgibsub-JU

# Server-only — required for User Management (create/remove staff logins)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Super admin email — this account always gets full admin access in the dashboard
SUPER_ADMIN_EMAIL=qicoding1@gmail.com

# Optional: same as ANON_KEY if your dashboard labels it "publishable"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── QE Assistant AI (public website chat — /api/qe-chat) ─────────────────────
# Pick provider: anthropic | google
QE_AI_PROVIDER=anthropic

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here
# Model ID examples: claude-haiku-4-5-20251001, claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Model ID examples: gemini-2.5-flash, gemini-2.5-pro, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-2.5-flash

# Regulatory updates feed (homepage) — cache duration in hours (default 6)
REGULATORY_UPDATES_CACHE_HOURS=6

