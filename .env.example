# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the "anon" / "public" key (safe for the browser). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: same as ANON_KEY if your dashboard labels it "publishable"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
